    <!-- ========== INGREDIENT STORY ========== -->
    <section class="section story" aria-labelledby="story-title" data-section data-story>
      <div class="container">
        <header class="section-head section-head--center">
          <p class="eyebrow reveal">Ingredient storytelling</p>
          <h2 id="story-title" class="display display--md reveal">What makes it good?</h2>
          <p class="section-head__support reveal">
            Five humble ingredients. Patient layers. One golden croissant.
          </p>
        </header>

        <div class="story__stage" data-ingredient-stage>
          <svg class="story__lines" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none">
            <line class="story__line" data-line="butter" x1="50" y1="50" x2="18" y2="18" />
            <line class="story__line" data-line="flour" x1="50" y1="50" x2="82" y2="20" />
            <line class="story__line" data-line="milk" x1="50" y1="50" x2="14" y2="72" />
            <line class="story__line" data-line="sugar" x1="50" y1="50" x2="82" y2="78" />
            <line class="story__line" data-line="salt" x1="50" y1="50" x2="90" y2="50" />
          </svg>

          <div class="story__product reveal" data-story-image>
            <img
              src="assets/images/butter-croissant.jpg"
              alt="Butter croissant — the heart of our ingredient story"
              width="560"
              height="560"
              loading="lazy"
            />
          </div>

          <button type="button" class="ingredient-pill ingredient-pill--butter" data-ingredient="butter">
            Butter
          </button>
          <button type="button" class="ingredient-pill ingredient-pill--flour" data-ingredient="flour">
            Flour
          </button>
          <button type="button" class="ingredient-pill ingredient-pill--milk" data-ingredient="milk">
            Milk
          </button>
          <button type="button" class="ingredient-pill ingredient-pill--sugar" data-ingredient="sugar">
            Sugar
          </button>
          <button type="button" class="ingredient-pill ingredient-pill--salt" data-ingredient="salt">
            Salt
          </button>

          <p class="story__hint">Tap an ingredient to highlight it</p>
        </div>
      </div>
    </section>

    <!-- ========== COFFEE EXPERIENCE ========== -->
    <section class="section coffee" data-coffee aria-labelledby="coffee-title" data-section>
      <div class="container coffee__layout">
        <div class="coffee__copy">
          <p class="eyebrow reveal">Crafted cup by cup</p>
          <h2 id="coffee-title" class="display display--md reveal">
            What’s in<br />your cup?
          </h2>
          <p class="coffee__poem reveal">
            Rich espresso.<br />
            Silky milk.<br />
            A little moment of calm.
          </p>
        </div>

        <div class="coffee__hero reveal" data-coffee-visual>
          <div class="coffee__bloom" aria-hidden="true"></div>
          <svg class="coffee__leaf" aria-hidden="true" viewBox="0 0 40 48" fill="currentColor">
            <path d="M20 2 C8 14, 4 28, 20 46 C36 28, 32 14, 20 2 Z"/>
          </svg>
          <div class="coffee__steam" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="coffee__frame">
            <img
              src="assets/images/coffee-layers.jpg"
              alt="Beautifully prepared latte in a cream ceramic cup with soft foam"
              width="640"
              height="800"
              loading="lazy"
            />
          </div>

          <span class="coffee-label coffee-label--espresso" data-coffee-label>Espresso</span>
          <span class="coffee-label coffee-label--milk" data-coffee-label>Steamed Milk</span>
          <span class="coffee-label coffee-label--foam" data-coffee-label>Foam</span>
        </div>
      </div>
    </section>

    <!-- ========== STAY A WHILE ========== -->
    <section class="section atmosphere" aria-labelledby="atmosphere-title" data-section>
      <div class="atmosphere__bleed">
        <div class="atmosphere__image reveal">
          <img
            src="assets/images/cafe-interior.jpg"
            alt="Warm modern cozy café interior with cream walls, dark wood furniture, soft sunlight, and plants"
            width="1400"
            height="900"
            loading="lazy"
          />
        </div>

        <div class="atmosphere__overlay reveal">
          <h2 id="atmosphere-title" class="display display--lg atmosphere__title">
            <span>Stay</span>
            <span>a while.</span>
          </h2>
          <p class="atmosphere__text">
            Bring your laptop.<br />
            Meet a friend.<br />
            Take a break.<br />
            Or simply enjoy your coffee.
          </p>
          <ul class="atmosphere__highlights" aria-label="Café atmosphere">
            <li class="atm-item" tabindex="0">
              <span class="atm-item__label">Wifi</span>
              <span class="atm-item__note">Stay connected while you stay awhile.</span>
            </li>
            <li class="atm-item" tabindex="0">
              <span class="atm-item__label">Comfy seating</span>
              <span class="atm-item__note">Take your time.</span>
            </li>
            <li class="atm-item" tabindex="0">
              <span class="atm-item__label">Good lighting</span>
              <span class="atm-item__note">Good for pages, screens, and slow mornings.</span>
            </li>
            <li class="atm-item" tabindex="0">
              <span class="atm-item__label">Study + work</span>
              <span class="atm-item__note">Bring the laptop. Stay for another cup.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ========== VISIT US ========== -->
    <section class="section visit" aria-labelledby="visit-title" data-section>
      <div class="container">
        <div class="visit__invite reveal">
          <p class="eyebrow">Find us</p>
          <h2 id="visit-title" class="display display--lg visit__title">
            <span>Come get</span>
            <span>cozy.</span>
          </h2>

          <div class="visit__details">
            <p class="visit__name">Cozy Café</p>
            <p class="visit__address">
              8834 E 34 Rd #131<br />
              Cadillac, MI 49601
            </p>
            <p class="visit__phone">
              <a href="tel:+15688289017">+1(56)88289017</a>
            </p>
          </div>

          <div class="visit__actions">
            <a
              class="btn btn--primary"
              href="https://maps.google.com/?q=8834+E+34+Rd+%23131+Cadillac+MI+49601"
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="GO →"
            >
              Get Directions <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href="menu.html" data-cursor="GO →">
              View Menu <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

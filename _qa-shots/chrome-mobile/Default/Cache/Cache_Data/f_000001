        </div>
      </div>
    </div>

    <!-- ========== INTRODUCTION ========== -->
    <section class="section intro" aria-labelledby="intro-title" data-section>
      <div class="container intro__layout">
        <div class="intro__heading">
          <p class="intro__label reveal">Cozy Café · Cadillac, MI</p>
          <h2 id="intro-title" class="display display--lg intro__title">
            <span class="reveal-line"><span>Good days</span></span>
            <span class="reveal-line"><span>start small.</span></span>
          </h2>
        </div>
        <div class="intro__body">
          <p class="intro__text reveal">
            Cozy Café is a welcoming spot for coffee,
            fresh food, relaxed conversations, and
            a little time for yourself.
          </p>
          <div class="intro__deco reveal" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="38" stroke="currentColor" stroke-width="1"/>
              <path d="M40 18 C28 30, 28 50, 40 62 C52 50, 52 30, 40 18 Z" fill="currentColor" opacity="0.35"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="section-wave section-wave--down" aria-hidden="true"></div>
    </section>

    <!-- ========== POPULAR ITEMS ========== -->
    <section class="section popular" aria-labelledby="popular-title" data-section>
      <div class="container">
        <header class="section-head">
          <div>
            <p class="eyebrow reveal">Start here</p>
            <h2 id="popular-title" class="display display--md reveal">The Good Stuff</h2>
          </div>
          <p class="section-head__support reveal">
            A few favorites worth slowing down for.
          </p>
        </header>

        <div class="food-mosaic" data-food-mosaic>
          <!-- Butter Croissant — featured -->
          <article
            class="food-card food-card--featured reveal"
            data-food-card
            data-cursor="EXPLORE"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label="Butter Croissant, $200. Activate to reveal ingredients."
          >
            <div class="food-card__media">
              <img
                src="assets/images/butter-croissant.jpg"
                alt="Freshly baked golden butter croissant with flaky layers on a cream ceramic plate"
                width="700"
                height="900"
                loading="lazy"
              />
            </div>
            <div class="food-card__scrim" aria-hidden="true"></div>
            <div class="food-card__body">
              <span class="food-card__price">$200</span>
              <h3 class="food-card__name">Butter Croissant</h3>
              <p class="food-card__tagline">Buttery · Flaky · Warm</p>
              <div class="food-card__reveal">
                <p class="food-card__ing-label">Ingredients</p>
                <p class="food-card__ing-line">Flour · Butter · Milk · Sugar · Salt</p>
                <a class="food-card__cta" href="menu.html" tabindex="-1" data-cursor="GO →">
                  View Item <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>

          <!-- Pancake Stack -->
          <article
            class="food-card food-card--medium reveal"
            data-food-card
            data-cursor="EXPLORE"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label="Pancake Stack, $800. Activate to reveal ingredients."
          >
            <div class="food-card__media">
              <img
                src="assets/images/pancake-stack.jpg"
                alt="Fluffy stack of pancakes with warm syrup and butter on a cream plate"
                width="600"
                height="700"
                loading="lazy"
              />
            </div>
            <div class="food-card__scrim" aria-hidden="true"></div>
            <div class="food-card__body">
              <span class="food-card__price">$800</span>
              <h3 class="food-card__name">Pancake Stack</h3>
              <p class="food-card__tagline">Fluffy · Sweet · Golden</p>
              <div class="food-card__reveal">
                <p class="food-card__ing-label">Ingredients</p>
                <p class="food-card__ing-line">Flour · Eggs · Milk · Butter · Maple</p>
                <a class="food-card__cta" href="menu.html" tabindex="-1" data-cursor="GO →">
                  View Item <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>

          <!-- Club Sandwich -->
          <article
            class="food-card food-card--medium food-card--offset reveal"
            data-food-card
            data-cursor="EXPLORE"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label="Club Sandwich, $500. Activate to reveal ingredients."
          >
            <div class="food-card__media">
              <img
                src="assets/images/club-sandwich.jpg"
                alt="Layered café club sandwich with toasted bread, lettuce, and tomato"
                width="600"
                height="700"
                loading="lazy"
              />
            </div>
            <div class="food-card__scrim" aria-hidden="true"></div>
            <div class="food-card__body">
              <span class="food-card__price">$500</span>
              <h3 class="food-card__name">Club Sandwich</h3>
              <p class="food-card__tagline">Stacked · Fresh · Satisfying</p>
              <div class="food-card__reveal">
                <p class="food-card__ing-label">Ingredients</p>
                <p class="food-card__ing-line">Bread · Chicken · Lettuce · Tomato · Mayo</p>
                <a class="food-card__cta" href="menu.html" tabindex="-1" data-cursor="GO →">
                  View Item <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>

          <!-- Coffee — no invented price -->
          <article
            class="food-card food-card--small reveal"
            data-food-card
            data-cursor="EXPLORE"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label="Coffee. Activate to reveal what's in the cup."
          >
            <div class="food-card__media">
              <img
                src="assets/images/coffee-cup.jpg"
                alt="Latte in a cream ceramic cup with visible foam texture"
                width="500"
                height="500"
                loading="lazy"
              />
            </div>
            <div class="food-card__scrim" aria-hidden="true"></div>
            <div class="food-card__body">
              <h3 class="food-card__name">Coffee</h3>
              <p class="food-card__tagline">Rich · Smooth · Steady</p>
              <div class="food-card__reveal">
                <p class="food-card__ing-label">In your cup</p>
                <p class="food-card__ing-line">Espresso · Steamed Milk · Foam</p>
                <a class="food-card__cta" href="menu.html" tabindex="-1" data-cursor="GO →">
                  View Item <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>

      <div class="marquee marquee--secondary">
        <div class="marquee__track marquee__track--reverse">
          <div class="marquee__group">
            <span>Slow Mornings</span><span class="marquee__dot">•</span>
            <span>Good Coffee</span><span class="marquee__dot">•</span>
            <span>Better Days</span><span class="marquee__dot">•</span>
            <span>Soft Light</span><span class="marquee__dot">•</span>
            <span>Warm Seats</span><span class="marquee__dot">•</span>
          </div>
          <div class="marquee__group" aria-hidden="true">
            <span>Slow Mornings</span><span class="marquee__dot">•</span>
            <span>Good Coffee</span><span class="marquee__dot">•</span>

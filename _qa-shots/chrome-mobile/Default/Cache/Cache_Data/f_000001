  <main id="main">
    <!-- ========== HERO ========== -->
    <section class="hero" data-hero aria-label="Welcome to Cozy Café">
      <div class="hero__stage">
        <!-- Depth layer -->
        <div class="hero__bloom" aria-hidden="true" data-parallax="bloom"></div>

        <!-- Layered image -->
        <div class="hero__media" data-parallax="media" data-pointer-tilt>
          <div class="hero__media-inner" data-parallax-img>
            <img
              src="assets/images/hero-latte.jpg"
              alt="Beautifully prepared latte in a cream ceramic cup on a dark wooden café table with soft morning light"
              width="900"
              height="1125"
              fetchpriority="high"
            />
          </div>
          <div class="hero__steam" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>

        <!-- Large overlapping type -->
        <h1 class="hero__title" data-parallax="title">
          <span class="hero__line"><span data-hero-line>COZY</span></span>
          <span class="hero__line hero__line--accent"><span data-hero-line>CAFÉ</span></span>
        </h1>

        <!-- Copy block -->
        <div class="hero__copy" data-parallax="copy">
          <p class="hero__tagline" data-hero-fade>Coffee. Food. Good vibes.</p>
          <p class="hero__lede" data-hero-fade>
            A cozy place for slow mornings, good food,
            great coffee, and time well spent.
          </p>
          <div class="hero__actions" data-hero-fade>
            <a class="btn btn--primary" href="menu.html" data-cursor="GO →">
              Explore the Menu <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href="contact.html" data-cursor="GO →">
              Visit Us <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Editorial decorations -->
        <span class="hero__place" data-parallax="place" data-hero-deco>Cadillac, MI</span>

        <svg class="hero__curve" data-parallax="curve" data-hero-deco aria-hidden="true" viewBox="0 0 200 40" fill="none">
          <path d="M4 28 C 50 4, 150 4, 196 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>

        <svg class="hero__bean hero__bean--1" data-parallax="bean1" data-hero-deco aria-hidden="true" viewBox="0 0 24 32" fill="currentColor">
          <ellipse cx="12" cy="16" rx="8" ry="14"/>
          <path d="M12 4 C10 12, 14 20, 12 28" fill="none" stroke="#F8F1E5" stroke-width="1.2"/>
        </svg>
        <svg class="hero__bean hero__bean--2" data-parallax="bean2" data-hero-deco aria-hidden="true" viewBox="0 0 24 32" fill="currentColor">
          <ellipse cx="12" cy="16" rx="8" ry="14"/>
          <path d="M12 4 C10 12, 14 20, 12 28" fill="none" stroke="#F8F1E5" stroke-width="1.2"/>
        </svg>

        <svg class="hero__leaf hero__leaf--1" data-parallax="leaf1" data-hero-deco aria-hidden="true" viewBox="0 0 40 48" fill="currentColor">
          <path d="M20 2 C8 14, 4 28, 20 46 C36 28, 32 14, 20 2 Z"/>
          <path d="M20 8 L20 40" fill="none" stroke="#F8F1E5" stroke-width="1" opacity="0.5"/>
        </svg>
        <svg class="hero__leaf hero__leaf--2" data-parallax="leaf2" data-hero-deco aria-hidden="true" viewBox="0 0 40 48" fill="currentColor">
          <path d="M20 2 C8 14, 4 28, 20 46 C36 28, 32 14, 20 2 Z"/>
        </svg>

        <img
          class="hero__logo-float"
          src="assets/images/logo.jpg"
          alt=""
          width="88"
          height="88"
          aria-hidden="true"
          data-parallax="logo"
          data-hero-deco
        />
      </div>
    </section>


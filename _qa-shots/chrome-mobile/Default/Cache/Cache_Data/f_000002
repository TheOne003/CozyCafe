.menu-cats__link.is-active {
  color: var(--color-brown);
}

.menu-cats__link.is-active::after {
  transform: scaleX(1);
}

/* Menu mosaics */
.menu-section {
  scroll-margin-top: calc(var(--nav-height) + var(--menu-cats-height) + 0.75rem);
}

.menu-mosaic {
  display: grid;
  gap: 1rem;
}

.menu-mosaic--breakfast {
  grid-template-columns: 1.3fr 1fr 1fr;
  grid-template-rows: auto auto auto;
}

.menu-mosaic--lunch {
  grid-template-columns: 1.25fr 1fr 1fr;
  grid-auto-rows: minmax(14rem, auto);
}

.menu-mosaic .food-card {
  min-height: 15rem;
}

.menu-mosaic .food-card--featured {
  grid-row: span 2;
  min-height: 32rem;
}

.menu-mosaic .food-card--medium {
  min-height: 18rem;
}

.menu-mosaic .food-card--small {
  min-height: 15rem;
}

/* Lunch feels slightly bolder */
.menu-section--lunch {
  background:
    linear-gradient(180deg, transparent, rgba(74, 44, 32, 0.04), transparent),
    linear-gradient(180deg, transparent 0%, rgba(232, 216, 195, 0.55) 40%, transparent 100%);
}

.menu-section--lunch .food-card__scrim {
  background: linear-gradient(
    to top,
    rgba(44, 33, 28, 0.88) 0%,
    rgba(44, 33, 28, 0.25) 48%,
    transparent 72%
  );
}

.menu-featured {
  background: radial-gradient(ellipse 60% 50% at 50% 55%, rgba(232, 216, 195, 0.55), transparent 70%);
}

/* Drinks placeholder */
.menu-drinks {
  background: var(--color-beige);
}

.menu-drinks__layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

.menu-drinks__text {
  font-size: clamp(1.1rem, 2vw, 1.3rem);
  color: var(--color-text-soft);
  max-width: 34ch;
  margin: 1.25rem 0 1rem;
  line-height: 1.55;
}

.menu-drinks__note {
  font-size: 0.9rem;
  color: var(--color-text-soft);
  opacity: 0.85;
  max-width: 38ch;
}

.menu-drinks__visual {
  display: grid;
  grid-template-columns: 1.2fr 0.9fr;
  grid-template-rows: 1fr 1fr;
  gap: 0.85rem;
  min-height: 22rem;
}

.menu-drinks__slot {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-cream);
  display: grid;
  place-items: end start;
  padding: 1rem;
  box-shadow: var(--shadow-soft);
}

.menu-drinks__slot:first-child {
  grid-row: span 2;
}

.menu-drinks__slot img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.menu-drinks__slot span {
  position: relative;
  z-index: 1;
  font-family: var(--font-display);
  font-size: 1.25rem;
  color: var(--color-cream);
  text-shadow: 0 2px 12px rgba(44, 33, 28, 0.35);
}

.menu-drinks__slot--ghost {
  border: 1.5px dashed rgba(74, 44, 32, 0.25);
  box-shadow: none;
  place-items: center;
  background: rgba(248, 241, 229, 0.55);
}

.menu-drinks__slot--ghost span {
  color: var(--color-brown);
  text-shadow: none;
  opacity: 0.55;
  font-size: 1rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

@media (max-width: 899px) {
  .menu-mosaic--breakfast,
  .menu-mosaic--lunch {
    grid-template-columns: 1fr 1fr;
  }

  .menu-mosaic .food-card--featured {
    grid-column: 1 / -1;
    grid-row: auto;
    min-height: 22rem;
  }

  .menu-drinks__layout {
    grid-template-columns: 1fr;
  }

  .menu-drinks__visual {
    min-height: 18rem;
  }
}

@media (max-width: 560px) {
  .menu-mosaic--breakfast,
  .menu-mosaic--lunch {
    grid-template-columns: 1fr;
  }

  .menu-mosaic .food-card--featured,
  .menu-mosaic .food-card--medium,
  .menu-mosaic .food-card--small {
    min-height: 18rem;
  }

  /* Mobile rhythm: alternate visual weight via spacing */
  .menu-mosaic .food-card--medium {
    min-height: 20rem;
  }

  .menu-cats__inner {
    gap: 0.25rem 1.15rem;
    overflow-x: auto;
    flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(74, 44, 32, 0.25) transparent;
    padding-bottom: 0.15rem;
  }

  .menu-cats__link {
    white-space: nowrap;
    flex: 0 0 auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .menu-hero__frame img,
  .menu-hero__eyebrow,
  .menu-hero__support,
  .menu-hero__actions,
  .menu-hero__leaf,
  .menu-hero__line > span {
    opacity: 1 !important;
    transform: none !important;
  }
}

/* =========================================================
   Contact page � invitation (inherits site system)
   ========================================================= */

.contact-hero {
  min-height: 92svh;
  padding: calc(var(--nav-height) + 1rem) 0 0;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse 55% 50% at 74% 38%, rgba(232, 216, 195, 0.9), transparent 70%),
    radial-gradient(ellipse 35% 30% at 12% 78%, rgba(95, 115, 85, 0.1), transparent 65%),
    var(--color-cream);
}

.contact-hero__stage {
  position: relative;
  width: var(--container);
  margin-inline: auto;
  min-height: calc(92svh - var(--nav-height) - 2rem);
  padding-bottom: 3rem;
  display: grid;
  align-content: center;
}

.contact-hero__bloom {
  position: absolute;
  top: 10%;
  right: 2%;
  width: min(48%, 480px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: rgba(232, 216, 195, 0.5);
  z-index: 0;
  pointer-events: none;
}

.contact-hero__media {
  position: absolute;
  top: 8%;
  right: -2%;
  width: min(50%, 520px);
  z-index: 1;
  rotate: 2deg;
  transition: transform 400ms var(--ease-out);
}

.contact-hero__frame {
  border-radius: 48% 52% 42% 58% / 44% 48% 52% 56%;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  box-shadow: var(--shadow-lift);
  background: var(--color-beige);
}

.contact-hero__frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.06);
  transition: transform 1.3s var(--ease-out);
}

.contact-hero.is-ready .contact-hero__frame img {
  transform: scale(1);
}

.contact-hero__bean,
.contact-hero__leaf {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
}

.contact-hero__bean {
  width: 16px;
  color: var(--color-brown);
  top: 18%;
  left: -6%;
  rotate: -24deg;
  transform: translateY(10px);
  transition-delay: 1s;
}

.contact-hero__leaf {
  width: 1.6rem;
  color: var(--color-green);
  bottom: 14%;
  right: 4%;
  rotate: 28deg;
  transform: translateY(10px);
  transition-delay: 1.15s;
}

.contact-hero.is-ready .contact-hero__bean,
.contact-hero.is-ready .contact-hero__leaf {
  opacity: 0.55;
  transform: translateY(0);
}

.contact-hero__copy {
  position: relative;
  z-index: 3;
  max-width: min(48%, 28rem);
  padding-top: clamp(1rem, 4vw, 2.5rem);
}

.contact-hero__place {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 1rem;
  padding: 0.4rem 0.8rem;
  border: 1px solid rgba(95, 115, 85, 0.35);
  border-radius: var(--radius-pill);
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
}

.contact-hero.is-ready .contact-hero__place {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.08s;
}

.contact-hero__title {
  font-size: clamp(4rem, 11vw, 7rem);
  margin-bottom: 1.35rem;
  line-height: 1;
}

.contact-hero__line {
  display: block;
  overflow: hidden;
  padding-bottom: 0.06em;
}

.contact-hero__line > span {
  display: block;
  transform: translateY(110%);
  transition: transform 1s var(--ease-out);
  padding-right: 0.14em;
}

.contact-hero.is-ready .contact-hero__line:nth-child(1) > span {
  transform: translateY(0);
  transition-delay: 0.18s;
}

.contact-hero.is-ready .contact-hero__line:nth-child(2) > span {
  transform: translateY(0);
  transition-delay: 0.34s;
}

.contact-hero.is-ready .contact-hero__line:nth-child(3) > span {
  transform: translateY(0);
  transition-delay: 0.5s;
}

.contact-hero__line--accent > span {
  color: var(--color-green);
  font-style: italic;
  font-weight: 450;
}

.contact-hero__support {
  font-size: clamp(1.1rem, 2vw, 1.3rem);
  line-height: 1.5;
  color: var(--color-text-soft);
  max-width: 28ch;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
}

.contact-hero.is-ready .contact-hero__support {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.72s;
}

@media (max-width: 899px) {
  .contact-hero { min-height: auto; }

  .contact-hero__stage {
    display: flex;
    flex-direction: column;
    min-height: auto;
    padding-bottom: 2.5rem;
  }

  .contact-hero__bloom { display: none; }

  .contact-hero__media {
    position: relative;
    top: auto;
    right: auto;
    width: min(90%, 380px);
    margin: 0.5rem auto 1.5rem;
    order: -1;
    rotate: 0deg;
  }

  .contact-hero__copy {
    max-width: none;
    padding-top: 0;
  }
}

@media (min-width: 900px) {
  .contact-hero__line > span {
    white-space: nowrap;
  }
}

/* Location story */
.contact-location {
  padding-top: var(--space-xl);
}

.contact-location__layout {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: clamp(2rem, 5vw, 4.5rem);
  align-items: center;
}

.contact-location__address {
  font-style: normal;
  margin: 2rem 0 1.5rem;
}

.contact-location__name {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 500;
  color: var(--color-brown);
  margin-bottom: 0.75rem;
}

.contact-location__lines {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2.8vw, 1.9rem);
  line-height: 1.35;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.contact-location__label {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 0.35rem;
}

.contact-location__phone {
  margin-bottom: 1.75rem;
}

.contact-location__phone a {
  font-size: clamp(1.2rem, 2.2vw, 1.45rem);
  font-weight: 600;
  color: var(--color-brown);
}

.contact-location__phone a:hover {
  color: var(--color-green);
}

.contact-location__visual {
  position: relative;
  justify-self: end;
  width: min(100%, 420px);
}

.contact-location__frame {
  border-radius: 42% 58% 48% 52% / 48% 42% 58% 52%;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  box-shadow: var(--shadow-lift);
}

.contact-location__frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms var(--ease-out);
}

@media (hover: hover) and (pointer: fine) {
  .contact-location__visual:hover .contact-location__frame img {
    transform: scale(1.04);
  }
}

.contact-location__curve {
  position: absolute;
  bottom: -0.5rem;
  left: -1rem;
  width: 8rem;
  color: var(--color-beige);
}

@media (max-width: 799px) {
  .contact-location__layout {
    grid-template-columns: 1fr;
  }

  .contact-location__visual {
    order: -1;
    justify-self: center;
    width: min(100%, 320px);
  }
}

/* Info + form panel */
.contact-panel {
  background: linear-gradient(180deg, transparent, rgba(232, 216, 195, 0.45), transparent);
}

.contact-panel__layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}

.contact-info__lede {
  color: var(--color-text-soft);
  max-width: 32ch;
  margin: 1rem 0 2rem;
  font-size: 1.1rem;
}

.contact-info__list {
  display: grid;
  gap: 1.35rem;
  margin-bottom: 2rem;
}

.contact-info__list dt {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 0.35rem;
}

.contact-info__list dd {
  color: var(--color-text);
  line-height: 1.5;
}

.contact-info__list a {
  font-weight: 600;
  color: var(--color-brown);
}

.contact-social__label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 0.75rem;
}

.contact-social__row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin-bottom: 0.65rem;
}

.contact-social__item {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 1rem;
  border-radius: var(--radius-pill);
  border: 1.5px dashed rgba(74, 44, 32, 0.28);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(74, 44, 32, 0.45);
  cursor: default;
  user-select: none;
}

.contact-social__note {
  font-size: 0.85rem;
  color: var(--color-text-soft);
}

/* Form */
.contact-form-wrap {
  position: relative;
  background: var(--color-white);
  border-radius: calc(var(--radius-lg) + 0.15rem);
  padding: clamp(1.5rem, 4vw, 2.5rem);
  box-shadow: var(--shadow-soft);
}

.contact-form {
  display: grid;
  gap: 1.15rem;
  transition: opacity 400ms var(--ease-soft), transform 400ms var(--ease-out);
}

.contact-form.is-hidden {
  opacity: 0;
  transform: translateY(12px);
  pointer-events: none;
  position: absolute;
  inset: clamp(1.5rem, 4vw, 2.5rem);
}

.form-field label {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-brown);
  margin-bottom: 0.45rem;
}

.form-field input,
.form-field textarea {
  width: 100%;
  font: inherit;
  color: var(--color-text);
  background: var(--color-cream);
  border: 1.5px solid rgba(74, 44, 32, 0.18);
  border-radius: var(--radius-sm);
  padding: 0.85rem 1rem;
  transition:
    border-color 220ms var(--ease-soft),
    box-shadow 220ms var(--ease-soft),
    background 220ms var(--ease-soft);
  resize: vertical;
}

.form-field input:hover,
.form-field textarea:hover {
  border-color: rgba(74, 44, 32, 0.32);
}

.form-field input:focus,
.form-field textarea:focus {
  outline: none;
  border-color: var(--color-green);
  box-shadow: 0 0 0 3px rgba(95, 115, 85, 0.2);
  background: var(--color-white);
}

.form-field.is-invalid input,
.form-field.is-invalid textarea {
  border-color: #8b3a2f;
  box-shadow: 0 0 0 3px rgba(139, 58, 47, 0.12);
}

.form-error {
  margin-top: 0.4rem;
  font-size: 0.85rem;
  color: #8b3a2f;
  min-height: 1.25em;
}

.form-field[data-form-field] {
  transition-delay: calc(var(--stagger, 0) * 70ms);
}

.contact-success {
  text-align: center;
  padding: 2rem 0.5rem;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
}

.contact-success.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.contact-success__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  color: var(--color-brown);
  margin-bottom: 0.75rem;
  line-height: 1;
}

.contact-success__text {
  color: var(--color-text-soft);
  font-size: 1.1rem;
  line-height: 1.55;
}

@media (max-width: 799px) {
  .contact-panel__layout {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .contact-hero__frame img,
  .contact-hero__place,
  .contact-hero__support,
  .contact-hero__bean,
  .contact-hero__leaf,
  .contact-hero__line > span {
    opacity: 1 !important;
    transform: none !important;
  }

  .contact-form,
  .contact-success {
    transition: none !important;
  }
}

/* =========================================================
   Site-wide consistency polish (final pass)
   ========================================================= */

/* Shared page hero rhythm */
.about-hero,
.menu-hero,
.contact-hero,
.hero {
  --hero-deco-opacity: 0.55;
}

/* Keep sticky menu cats readable */
.menu-cats {
  box-shadow: 0 6px 18px rgba(44, 33, 28, 0.04);
}

.menu-cats__link:focus-visible {
  outline-offset: 4px;
}

/* Food card keyboard focus ring that stays visible over media */
.food-card:focus-visible {
  outline: 2px solid var(--color-cream);
  outline-offset: 3px;
  box-shadow: var(--shadow-lift), 0 0 0 4px rgba(95, 115, 85, 0.35);
}

/* Belief keyboard focus ring */
.belief:focus-visible {
  outline: 2px solid var(--color-green);
  outline-offset: 4px;
  border-radius: var(--radius-sm);
}

/* Form invalid uses shared error color */
.form-field.is-invalid input,
.form-field.is-invalid textarea {
  border-color: var(--color-error);
  box-shadow: 0 0 0 3px rgba(139, 58, 47, 0.12);
}

.form-error {
  color: var(--color-error);
  min-height: 1.25em;
}

/* Comfortable full-width CTAs on narrow phones */
@media (max-width: 419px) {
  .hero__title,
  .about-hero__title,
  .menu-hero__title,
  .contact-hero__title,
  .about-close__title {
    font-size: clamp(3.25rem, 15vw, 4.5rem);
  }

  .display--lg {
    font-size: clamp(2.75rem, 12vw, 3.75rem);
  }

  .btn {
    width: 100%;
    justify-content: center;
  }

  .hero__actions,
  .visit__actions,
  .about-close__actions,
  .menu-hero__actions {
    width: 100%;
  }
}

/* Soften hero deco density on mid mobile */
@media (max-width: 560px) {
  .hero__bean--1,
  .hero__leaf--1,
  .contact-hero__bean,
  .menu-hero__leaf,
  .about-hero__leaf {
    opacity: 0.35;
  }

  .ingredient-pill {
    font-size: 0.65rem;
    padding: 0.4rem 0.65rem;
  }
}

/* Ensure footer social placeholders never look like live links */
.footer__social span,
.contact-social__item {
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .food-card:hover,
  .food-card.is-active,
  .food-card:focus-visible {
    transform: none;
  }
}

/* Final QA polish */
.contact-success .btn {
  margin-top: 1.5rem;
}

.contact-success:focus {
  outline: none;
}

/* Keep mobile menu panel clickable as overlay dismiss target */
@media (max-width: 899px) {
  .nav__panel.is-open {
    cursor: default;
  }
}

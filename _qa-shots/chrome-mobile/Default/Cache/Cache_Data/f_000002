/* =========================================================
   Cozy Café — Design System & Home Page
   Warm Editorial Café × Playful Food Storytelling × Motion
   ========================================================= */

:root {
  --color-brown: #4A2C20;
  --color-cream: #F8F1E5;
  --color-beige: #E8D8C3;
  --color-green: #5F7355;
  --color-white: #FFFDF8;
  --color-text: #2C211C;
  --color-text-soft: rgba(44, 33, 28, 0.68);
  --color-brown-soft: rgba(74, 44, 32, 0.08);
  --color-green-soft: rgba(95, 115, 85, 0.14);
  --color-error: #8b3a2f;

  --font-display: "Fraunces", "Georgia", serif;
  --font-body: "Figtree", "Segoe UI", sans-serif;

  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.75rem;
  --space-lg: 3rem;
  --space-xl: 5rem;
  --space-2xl: 8rem;

  --nav-height: 5rem;
  --menu-cats-height: 3.25rem;
  --container: min(1180px, calc(100% - 2.5rem));
  --radius-sm: 0.5rem;
  --radius-md: 1.25rem;
  --radius-lg: 2rem;
  --radius-pill: 999px;

  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft: cubic-bezier(0.4, 0, 0.2, 1);
  --duration-micro: 280ms;
  --duration-fast: 220ms;
  --duration: 480ms;
  --duration-slow: 800ms;

  --shadow-soft: 0 12px 40px rgba(44, 33, 28, 0.1);
  --shadow-lift: 0 20px 50px rgba(44, 33, 28, 0.16);
  --focus-ring: 0 0 0 3px rgba(95, 115, 85, 0.35);
}

/* ---------- Reset ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--nav-height) + 1rem);
}

body {
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.65;
  color: var(--color-text);
  background: var(--color-cream);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

button {
  font: inherit;
  border: none;
  background: none;
  cursor: pointer;
  color: inherit;
}

button:focus-visible,
a:focus-visible,
[tabindex]:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--color-green);
  outline-offset: 3px;
}

.skip-link {
  position: absolute;
  left: 1rem;
  top: -100px;
  z-index: 1000;
  background: var(--color-brown);
  color: var(--color-cream);
  padding: 0.75rem 1.25rem;
  border-radius: var(--radius-sm);
}

.skip-link:focus {
  top: 1rem;
}

/* ---------- Typography ---------- */
.display {
  font-family: var(--font-display);
  font-weight: 500;
  line-height: 0.94;
  letter-spacing: -0.03em;
  color: var(--color-brown);
}

.display--lg {
  font-size: clamp(3.25rem, 9vw, 6.5rem);
}

.display--md {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
}

.display--sm {
  font-size: clamp(2rem, 4.5vw, 3rem);
}

.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 0.85rem;
}

.container {
  width: var(--container);
  margin-inline: auto;
}

.section {
  padding: var(--space-xl) 0;
  position: relative;
  scroll-margin-top: calc(var(--nav-height) + 1rem);
}

.section-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: end;
  gap: 1.5rem;
  margin-bottom: clamp(2rem, 4vw, 3.5rem);
}

.section-head--center {
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.section-head__support {
  color: var(--color-text-soft);
  max-width: 26ch;
  font-size: 1.05rem;
}

.section-head--center .section-head__support {
  max-width: 36ch;
}

.section-wave {
  height: 4rem;
  background:
    radial-gradient(ellipse 80% 100% at 50% 0%, var(--color-beige), transparent 70%);
  pointer-events: none;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.95rem 1.55rem;
  border-radius: var(--radius-pill);
  font-weight: 600;
  font-size: 0.92rem;
  letter-spacing: 0.02em;
  transition:
    transform var(--duration-micro) var(--ease-out),
    box-shadow var(--duration-micro) var(--ease-out),
    background var(--duration-micro) var(--ease-soft),
    color var(--duration-micro) var(--ease-soft),
    border-color var(--duration-micro) var(--ease-soft);
}

.btn__arrow {
  display: inline-block;
  transition: transform var(--duration-micro) var(--ease-out);
}

.btn:hover {
  transform: translateY(-3px);
}

.btn:hover .btn__arrow {
  transform: translateX(6px);
}

.btn:active {
  transform: translateY(-1px);
}

.btn--primary {
  background: var(--color-brown);
  color: var(--color-cream);
  box-shadow: 0 8px 24px rgba(74, 44, 32, 0.22);
}

.btn--primary:hover {
  background: #3a2218;
  box-shadow: var(--shadow-lift);
}

.btn--ghost {
  background: transparent;
  color: var(--color-brown);
  border: 1.5px solid rgba(74, 44, 32, 0.28);
}

.btn--ghost:hover {
  background: var(--color-brown);
  color: var(--color-cream);
  border-color: var(--color-brown);
}

/* ---------- Navigation ---------- */
.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 200;
  height: var(--nav-height);
  opacity: 0;
  transform: translateY(-12px);
  transition:
    background var(--duration) var(--ease-soft),
    box-shadow var(--duration) var(--ease-soft),
    backdrop-filter var(--duration) var(--ease-soft),
    opacity 0.7s var(--ease-out),
    transform 0.7s var(--ease-out);
}

.site-header.is-ready {
  opacity: 1;
  transform: translateY(0);
}

.site-header.is-scrolled {
  background: rgba(248, 241, 229, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 8px 30px rgba(44, 33, 28, 0.08);
}

.site-header.is-scrolled .nav__wordmark,
.site-header.is-scrolled .nav__links a {
  color: var(--color-brown);
}

.nav {
  width: var(--container);
  height: 100%;
  margin-inline: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.nav__brand {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  z-index: 220;
}

.nav__logo {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  object-fit: cover;
  box-shadow: 0 4px 14px rgba(74, 44, 32, 0.18);
}

.nav__wordmark {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--color-brown);
  letter-spacing: -0.02em;
}

.nav__panel {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav__links {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav__links a {
  font-size: 0.92rem;
  font-weight: 500;
  position: relative;
  transition: color var(--duration-fast);
}

.nav__links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -0.35rem;
  width: 100%;
  height: 1.5px;
  background: var(--color-green);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--duration-fast) var(--ease-out);
}

.nav__links a:hover::after,
.nav__links a[aria-current="page"]::after {
  transform: scaleX(1);
}

.nav__visit {
  padding: 0.7rem 1.25rem;
  font-size: 0.85rem;
}

.nav__toggle {
  display: none;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  border: 1.5px solid rgba(74, 44, 32, 0.32);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
  z-index: 220;
  background: rgba(248, 241, 229, 0.92);
  box-shadow: 0 2px 10px rgba(74, 44, 32, 0.08);
  margin-left: auto;
  flex-shrink: 0;
}

.nav__toggle span:not(.visually-hidden) {
  display: block;
  width: 1.15rem;
  height: 1.75px;
  background: var(--color-brown);
  transition: transform var(--duration) var(--ease-out), opacity var(--duration-fast);
}

.nav__toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(6.5px) rotate(45deg);
}

.nav__toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav__toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-6.5px) rotate(-45deg);
}

@media (max-width: 899px) {
  .nav__toggle {
    display: inline-flex;
  }

  .nav__panel {
    position: fixed;
    inset: 0;
    z-index: 210;
    background: var(--color-cream);
    background-image:
      radial-gradient(ellipse 70% 50% at 80% 15%, rgba(232, 216, 195, 0.85), transparent 70%),
      radial-gradient(ellipse 50% 40% at 10% 85%, rgba(95, 115, 85, 0.1), transparent 65%);
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-16px);
    transition:
      opacity var(--duration) var(--ease-soft),
      visibility var(--duration),
      transform var(--duration) var(--ease-out);
  }

  .nav__panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav__links {
    flex-direction: column;
    gap: 1.5rem;
  }

  .nav__links a {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--color-brown);
  }

  .nav__links a::after {
    display: none;
  }

  .nav__visit {
    font-size: 0.95rem;
    padding: 1rem 1.75rem;
  }
}

body.menu-open {
  overflow: hidden;
}

body.menu-open .site-header {
  background: var(--color-cream);
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* ---------- HERO (layered editorial) ---------- */
.hero {
  min-height: 100svh;
  padding: calc(var(--nav-height) + 0.5rem) 0 0;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse 55% 50% at 70% 40%, rgba(232, 216, 195, 0.85), transparent 70%),
    radial-gradient(ellipse 40% 35% at 10% 75%, rgba(95, 115, 85, 0.1), transparent 65%),
    var(--color-cream);
}

.hero__stage {
  position: relative;
  width: var(--container);
  margin-inline: auto;
  min-height: calc(100svh - var(--nav-height) - 1rem);
  padding-bottom: 2.5rem;
}

/* Image — organic shape, overlapping type */
.hero__bloom {
  position: absolute;
  top: 8%;
  right: 4%;
  width: min(58%, 580px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: rgba(232, 216, 195, 0.55);
  z-index: 0;
  pointer-events: none;
}

.hero__media {
  position: absolute;
  top: 2%;
  right: -4%;
  width: min(54%, 560px);
  z-index: 1;
  will-change: transform;
  rotate: -2.5deg;
}

.hero__media-inner {
  border-radius: 68% 32% 54% 46% / 38% 58% 42% 62%;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  box-shadow: var(--shadow-lift);
  background: var(--color-beige);
}

.hero__media-inner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.06);
  transition: transform 1.4s var(--ease-out);
  will-change: transform;
}

.hero.is-ready .hero__media-inner img {
  transform: scale(1);
}

.hero__steam {
  position: absolute;
  top: 12%;
  left: 42%;
  width: 28px;
  height: 3.5rem;
  opacity: 0.4;
  pointer-events: none;
}

.hero__steam span {
  position: absolute;
  width: 2px;
  height: 100%;
  background: linear-gradient(to top, transparent, var(--color-brown));
  border-radius: var(--radius-pill);
  animation: steamRise 3.6s ease-in-out infinite;
}

.hero__steam span:nth-child(2) {
  left: 10px;
  height: 78%;
  animation-delay: 0.55s;
}

.hero__steam span:nth-child(3) {
  left: 20px;
  height: 62%;
  animation-delay: 1.1s;
}

@keyframes steamRise {
  0%, 100% { transform: translateY(10px) scaleY(0.8); opacity: 0.1; }
  50% { transform: translateY(-8px) scaleY(1); opacity: 0.5; }
}

/* Oversized type overlapping image */
.hero__title {
  position: relative;
  z-index: 3;
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(5.25rem, 17vw, 12rem);
  line-height: 0.84;
  letter-spacing: -0.045em;
  color: var(--color-brown);
  padding-top: clamp(0.5rem, 3vw, 2.25rem);
  max-width: 9ch;
  pointer-events: none;
  will-change: transform;
  mix-blend-mode: normal;
  text-shadow: 0 1px 0 rgba(248, 241, 229, 0.35);
}

.hero__line {
  display: block;
  overflow: hidden;
}

.hero__line > span {
  display: block;
  transform: translateY(110%);
  opacity: 0;
  transition:
    transform 1s var(--ease-out),
    opacity 1s var(--ease-out);
}

.hero.is-ready .hero__line:nth-child(1) > span {
  transform: translateY(0);
  opacity: 1;
  transition-delay: 0.15s;
}

.hero.is-ready .hero__line:nth-child(2) > span {
  transform: translateY(0);
  opacity: 1;
  transition-delay: 0.38s;
}

.hero__line--accent {
  margin-left: clamp(0.5rem, 4vw, 3.5rem);
}

.hero__line--accent > span {
  color: var(--color-green);
  font-style: italic;
  font-weight: 450;
}

.hero__copy {
  position: relative;
  z-index: 4;
  margin-top: clamp(1.5rem, 4vw, 3rem);
  max-width: 28rem;
  will-change: transform, opacity;
}

.hero__tagline {
  font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  font-weight: 500;
  color: var(--color-brown);
  margin-bottom: 0.75rem;
}

.hero__lede {
  color: var(--color-text-soft);
  font-size: clamp(1rem, 1.6vw, 1.15rem);
  margin-bottom: 1.75rem;
  max-width: 34ch;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
}

.hero__tagline,
.hero__lede,
.hero__actions {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 0.8s var(--ease-out),
    transform 0.8s var(--ease-out);
}

.hero.is-ready .hero__tagline {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.62s;
}

.hero.is-ready .hero__lede {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.78s;
}

.hero.is-ready .hero__actions {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.94s;
}

/* Decorations */
.hero__place {
  position: absolute;
  top: 18%;
  left: 42%;
  z-index: 5;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-green);
  padding: 0.45rem 0.85rem;
  border: 1px solid rgba(95, 115, 85, 0.35);
  border-radius: var(--radius-pill);
  background: rgba(248, 241, 229, 0.85);
  backdrop-filter: blur(6px);
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.7s var(--ease-out) 1.1s, transform 0.7s var(--ease-out) 1.1s;
}

.hero.is-ready .hero__place {
  opacity: 1;
  transform: translateY(0);
}

.hero__curve {
  position: absolute;
  bottom: 22%;
  left: 38%;
  width: 140px;
  color: var(--color-beige);
  opacity: 0;
  transition: opacity 0.8s var(--ease-out) 1.2s;
  pointer-events: none;
}

.hero.is-ready .hero__curve {
  opacity: 1;
}

.hero__bean {
  position: absolute;
  width: 18px;
  color: var(--color-brown);
  opacity: 0;
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  pointer-events: none;
}

.hero__bean--1 {
  top: 28%;
  left: 8%;
  transform: rotate(-28deg) translateY(16px);
  transition-delay: 1.15s;
}

.hero__bean--2 {
  bottom: 30%;
  right: 48%;
  width: 14px;
  transform: rotate(18deg) translateY(12px);
  transition-delay: 1.3s;
}

.hero.is-ready .hero__bean {
  opacity: 0.55;
  transform: rotate(var(--r, -28deg)) translateY(0);
}

.hero.is-ready .hero__bean--1 { --r: -28deg; }
.hero.is-ready .hero__bean--2 { --r: 18deg; opacity: 0.4; }

.hero__leaf {
  position: absolute;
  width: 28px;
  color: var(--color-green);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
}

.hero__leaf--1 {
  top: 12%;
  right: 46%;
  transform: rotate(-20deg) translateY(14px);
  transition-delay: 1.2s;
}

.hero__leaf--2 {
  bottom: 18%;
  left: 52%;
  width: 22px;
  transform: rotate(35deg) translateY(10px);
  transition-delay: 1.35s;
}

.hero.is-ready .hero__leaf {
  opacity: 0.65;
  transform: rotate(var(--lr, -20deg)) translateY(0);
}

.hero.is-ready .hero__leaf--1 { --lr: -20deg; }
.hero.is-ready .hero__leaf--2 { --lr: 35deg; opacity: 0.45; }

.hero__logo-float {
  position: absolute;
  bottom: 8%;
  right: 8%;
  width: 5.5rem;
  height: 5.5rem;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--color-cream);
  box-shadow: var(--shadow-soft);
  z-index: 4;
  opacity: 0;
  transform: scale(0.9) translateY(12px);
  transition: opacity 0.8s var(--ease-out) 1.25s, transform 0.8s var(--ease-out) 1.25s;
}

.hero.is-ready .hero__logo-float {
  opacity: 1;
  transform: scale(1) translateY(0);
}

@media (max-width: 899px) {
  .hero__stage {
    display: flex;
    flex-direction: column;
    min-height: auto;
    padding-bottom: 2rem;
  }

  .hero__media {
    position: relative;
    top: auto;
    right: auto;
    width: min(88%, 360px);
    margin: 0.5rem auto 0;
    order: -1;
    rotate: 0deg;
  }

  .hero__bloom {
    display: none;
  }

  .hero__title {
    font-size: clamp(4rem, 18vw, 5.5rem);
    padding-top: 1.25rem;
    max-width: none;
  }

  .hero__line--accent {
    margin-left: 1.25rem;
  }

  .hero__place {
    top: auto;
    left: auto;
    position: relative;
    display: inline-flex;
    margin-top: 0.75rem;
    align-self: flex-start;
  }

  .hero__curve,
  .hero__bean--2,
  .hero__leaf--2 {
    display: none;
  }

  .hero__logo-float {
    width: 4.25rem;
    height: 4.25rem;
    bottom: auto;
    right: 6%;
    top: 8%;
  }

  .hero__copy {
    margin-top: 1.25rem;
  }
}

/* ---------- Marquee ---------- */
.marquee-band {
  background: var(--color-brown);
  color: var(--color-cream);
  padding: 1.45rem 0 1.25rem;
  overflow: hidden;
  position: relative;
  z-index: 5;
}

.marquee {
  overflow: hidden;
}

.marquee--secondary {
  margin-top: 0.45rem;
  opacity: 0.5;
}

.marquee__track {
  display: flex;
  width: max-content;
  animation: marqueeScroll 52s linear infinite;
  will-change: transform;
}

.marquee__track--reverse {
  animation-direction: reverse;
  animation-duration: 64s;
}

.marquee__group {
  display: flex;
  align-items: center;
  gap: 1.6rem;
  padding-right: 1.6rem;
  white-space: nowrap;
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 3.2vw, 2.15rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.marquee--secondary .marquee__group {
  font-size: clamp(0.9rem, 1.9vw, 1.1rem);
  letter-spacing: 0.16em;
}

.marquee__dot {
  color: #a8b89f;
  font-size: 0.65em;
}

@keyframes marqueeScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-33.333%); }
}

/* ---------- Intro ---------- */
.intro {
  padding: var(--space-2xl) 0 var(--space-lg);
  overflow: hidden;
}

.intro__layout {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: clamp(2.5rem, 8vw, 7rem);
  align-items: end;
}

.intro__label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-green);
  margin-bottom: 1.5rem;
}

.intro__title {
  font-size: clamp(3.75rem, 11vw, 7.5rem);
}

.intro__text {
  font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  line-height: 1.5;
  color: var(--color-text-soft);
  max-width: 26ch;
  margin-left: clamp(0rem, 4vw, 2.5rem);
}

.intro__title .reveal-line {
  display: block;
  overflow: hidden;
}

.intro__title .reveal-line > span {
  display: block;
  transform: translateY(110%);
  transition: transform 0.9s var(--ease-out);
}

.intro__title.is-visible .reveal-line > span,
.intro__title .reveal-line.is-visible > span {
  transform: translateY(0);
}

.intro__title .reveal-line:nth-child(2) > span,
.intro__title .reveal-line:nth-child(2).is-visible > span {
  transition-delay: 0.12s;
}

/* When parent has is-visible from reveal observer on lines */
.reveal-line.is-visible > span {
  transform: translateY(0);
}

.intro__deco {
  margin-top: 2.25rem;
  width: 4.5rem;
  color: var(--color-green);
  opacity: 0.7;
  margin-left: clamp(0rem, 4vw, 2.5rem);
}

@media (max-width: 799px) {
  .intro__layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .intro__text,
  .intro__deco {
    margin-left: 0;
  }
}

/* ---------- Popular / Food mosaic ---------- */
.popular {
  background: linear-gradient(180deg, transparent 0%, rgba(232, 216, 195, 0.4) 35%, transparent 100%);
  padding-top: var(--space-lg);
}

.food-mosaic {
  display: grid;
  grid-template-columns: 1.35fr 1fr 0.9fr;
  grid-template-rows: 19rem 15rem;
  gap: 1rem;
  align-items: stretch;
}

.food-card {
  position: relative;
  border-radius: calc(var(--radius-lg) + 0.15rem);
  overflow: hidden;
  background: var(--color-beige);
  cursor: pointer;
  isolation: isolate;
  min-height: 14rem;
  transition:
    transform 280ms var(--ease-out),
    box-shadow 280ms var(--ease-out);
}

.food-card--featured {
  grid-row: 1 / -1;
  min-height: 36rem;
  z-index: 2;
}

.food-card--medium {
  min-height: 19rem;
}

.food-card--offset {
  transform: translateY(0.75rem);
}

.food-card--small {
  grid-column: 2 / -1;
  min-height: 14.5rem;
  width: 78%;
  justify-self: end;
  border-radius: 40% 60% 55% 45% / 45% 40% 60% 55%;
  z-index: 3;
  margin-top: -1.25rem;
}

.food-card:hover,
.food-card.is-active,
.food-card:focus-visible {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lift);
  z-index: 4;
}

.food-card--offset:hover,
.food-card--offset.is-active,
.food-card--offset:focus-visible {
  transform: translateY(calc(0.75rem - 8px));
}

.food-card__media {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.food-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms var(--ease-out);
}

.food-card:hover .food-card__media img,
.food-card.is-active .food-card__media img,
.food-card:focus-visible .food-card__media img {
  transform: scale(1.05) translateY(-2px);
}

.food-card__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to top,
    rgba(44, 33, 28, 0.82) 0%,
    rgba(44, 33, 28, 0.18) 48%,
    transparent 72%
  );
  transition: background 320ms var(--ease-soft);
}

.food-card:hover .food-card__scrim,
.food-card.is-active .food-card__scrim,
.food-card:focus-visible .food-card__scrim {
  background: linear-gradient(
    to top,
    rgba(44, 33, 28, 0.92) 0%,
    rgba(44, 33, 28, 0.52) 52%,
    rgba(44, 33, 28, 0.2) 100%
  );
}

.food-card__body {
  position: absolute;
  inset: auto 0 0;
  z-index: 2;
  padding: 1.35rem 1.45rem 1.45rem;
  color: var(--color-cream);
}

.food-card--featured .food-card__body {
  padding: 1.75rem 1.85rem 2rem;
}

.food-card__price {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--color-beige);
  margin-bottom: 0.3rem;
  opacity: 1;
  visibility: visible;
}

.food-card__name {
  font-family: var(--font-display);
  font-size: clamp(1.45rem, 2.4vw, 2rem);
  line-height: 1.05;
  margin-bottom: 0.3rem;
}

.food-card--featured .food-card__name {
  font-size: clamp(2.1rem, 3.5vw, 3.15rem);
}

.food-card__tagline {
  font-size: 0.92rem;
  opacity: 0.78;
  transition: opacity 280ms var(--ease-soft);
}

.food-card:hover .food-card__tagline,
.food-card.is-active .food-card__tagline,
.food-card:focus-visible .food-card__tagline {
  opacity: 1;
}

.food-card__reveal {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  margin-top: 0;
  transition:
    max-height 380ms var(--ease-out),
    opacity 320ms var(--ease-soft),
    margin 320ms var(--ease-soft);
}

.food-card:hover .food-card__reveal,
.food-card.is-active .food-card__reveal,
.food-card:focus-visible .food-card__reveal {
  max-height: 10rem;
  opacity: 1;
  margin-top: 0.95rem;
}

.food-card__ing-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  opacity: 0.7;
  margin-bottom: 0.4rem;
}

.food-card__ing-line {
  font-size: 0.88rem;
  line-height: 1.45;
  opacity: 0.92;
  margin-bottom: 0.9rem;
  max-width: 28ch;
}

.food-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.food-card:hover .food-card__cta .btn__arrow,
.food-card.is-active .food-card__cta .btn__arrow {
  transform: translateX(6px);
}

@media (hover: hover) and (pointer: fine) {
  .food-card .food-card__cta {
    pointer-events: auto;
  }
}

@media (max-width: 899px) {
  .food-mosaic {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }

  .food-card--featured {
    grid-column: 1 / -1;
    grid-row: auto;
    min-height: 24rem;
  }

  .food-card--small {
    grid-column: 1 / -1;
    width: 100%;
    margin-top: 0;
    border-radius: var(--radius-lg);
    justify-self: stretch;
  }

  .food-card--offset {
    transform: none;
  }
}

@media (max-width: 560px) {
  .food-mosaic {
    grid-template-columns: 1fr;
  }

  .food-card--featured,
  .food-card--medium,
  .food-card--small {
    grid-column: auto;
    min-height: 20rem;
  }
}

/* ---------- Ingredient story ---------- */
.story {
  background:
    radial-gradient(ellipse 60% 50% at 50% 60%, rgba(232, 216, 195, 0.55), transparent 70%);
  overflow: hidden;
}

.story__stage {
  position: relative;
  max-width: 640px;
  margin: 0 auto;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
}

.story__lines {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  overflow: visible;
}

.story__line {
  stroke: var(--color-green);
  stroke-width: 0.35;
  stroke-dasharray: 2 2;
  opacity: 0;
  transition: opacity 320ms var(--ease-soft);
}

.story__line.is-on {
  opacity: 0.55;
}

.story__product {
  width: min(58%, 310px);
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  border: 8px solid var(--color-white);
  box-shadow: var(--shadow-lift);
  z-index: 2;
  position: relative;
  transition: transform 350ms var(--ease-out), box-shadow 350ms var(--ease-out);
}

.story__product img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms var(--ease-out);
}

.story__stage.has-focus .story__product {
  transform: scale(1.04);
  box-shadow: 0 24px 56px rgba(44, 33, 28, 0.18);
}

.story__stage.has-focus .story__product img {
  transform: scale(1.03);
}

.ingredient-pill {
  position: absolute;
  z-index: 3;
  padding: 0.6rem 1.1rem;
  background: var(--color-white);
  color: var(--color-brown);
  border-radius: var(--radius-pill);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  box-shadow: var(--shadow-soft);
  border: 1.5px solid transparent;
  opacity: 0;
  transition:
    opacity 0.7s var(--ease-out),
    transform 0.7s var(--ease-out),
    border-color 250ms,
    box-shadow 250ms,
    background 250ms,
    color 250ms,
    font-size 250ms;
}

.ingredient-pill--butter {
  top: 10%;
  left: 50%;
  margin-left: -2.6rem;
  transform: translateY(-18px);
}

.ingredient-pill--flour {
  top: 38%;
  left: 0;
  transform: translateX(-20px);
}

.ingredient-pill--milk {
  top: 38%;
  right: 0;
  transform: translateX(20px);
}

.ingredient-pill--sugar {
  bottom: 14%;
  left: 18%;
  transform: translateY(16px);
}

.ingredient-pill--salt {
  bottom: 14%;
  right: 16%;
  transform: scale(0.88);
}

.story__stage.is-inview .ingredient-pill {
  opacity: 1;
  transform: none;
  margin-left: 0;
}

.story__stage.is-inview .ingredient-pill--butter {
  left: 50%;
  transform: translateX(-50%);
  transition-delay: 0.15s;
}

.story__stage.is-inview .ingredient-pill--flour { transition-delay: 0.28s; }
.story__stage.is-inview .ingredient-pill--milk { transition-delay: 0.4s; }
.story__stage.is-inview .ingredient-pill--sugar { transition-delay: 0.52s; }
.story__stage.is-inview .ingredient-pill--salt { transition-delay: 0.64s; }

.ingredient-pill.is-active,
.ingredient-pill:hover,
.ingredient-pill:focus-visible {
  background: var(--color-brown);
  color: var(--color-cream);
  border-color: var(--color-brown);
  box-shadow: var(--shadow-lift);
  font-size: 0.84rem;
}

.story__hint {
  position: absolute;
  bottom: -0.75rem;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.82rem;
  color: var(--color-text-soft);
  white-space: nowrap;
}

@media (max-width: 600px) {
  .story__stage {
    max-width: 340px;
    margin-bottom: 2.5rem;
  }

  .ingredient-pill {
    font-size: 0.68rem;
    padding: 0.45rem 0.75rem;
  }

  .story__lines {
    display: none;
  }

  .story__hint {
    bottom: -1.75rem;
  }
}

/* ---------- Coffee ---------- */
.coffee {
  background: var(--color-brown);
  color: var(--color-cream);
  overflow: hidden;
}

.coffee .display,
.coffee .eyebrow {
  color: var(--color-cream);
}

.coffee .eyebrow {
  color: #a8b89f;
}

.coffee #coffee-title {
  font-size: clamp(3rem, 7vw, 5.25rem);
}

.coffee__layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

.coffee__poem {
  margin-top: 1.5rem;
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2.5vw, 1.85rem);
  line-height: 1.45;
  font-weight: 400;
  color: rgba(248, 241, 229, 0.85);
}

.coffee__hero {
  position: relative;
  max-width: 480px;
  margin-inline: auto;
  min-height: 30rem;
  display: grid;
  place-items: center;
}

.coffee__bloom {
  position: absolute;
  width: 88%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: rgba(248, 241, 229, 0.08);
  z-index: 0;
  pointer-events: none;
}

.coffee__leaf {
  position: absolute;
  width: 2rem;
  color: #a8b89f;
  opacity: 0.55;
  z-index: 3;
  top: 12%;
  right: 8%;
  rotate: 28deg;
  pointer-events: none;
}

.coffee__frame {
  width: 74%;
  aspect-ratio: 3 / 4;
  border-radius: 48% 52% 45% 55% / 40% 42% 58% 60%;
  overflow: hidden;
  box-shadow: 0 28px 60px rgba(0, 0, 0, 0.35);
  position: relative;
  z-index: 2;
}

.coffee__frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.08);
  transition: transform 1.2s var(--ease-out);
}

.coffee.is-inview .coffee__frame img {
  transform: scale(1);
}

.coffee__steam {
  position: absolute;
  top: 4%;
  left: 46%;
  width: 36px;
  height: 4.5rem;
  z-index: 3;
  opacity: 0.5;
  pointer-events: none;
}

.coffee__steam span {
  position: absolute;
  width: 3px;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(to top, transparent, rgba(248, 241, 229, 0.7));
  filter: blur(1px);
  animation: steamDrift 4.2s ease-in-out infinite;
}

.coffee__steam span:nth-child(2) { left: 12px; height: 78%; animation-delay: 0.55s; }
.coffee__steam span:nth-child(3) { left: 24px; height: 62%; animation-delay: 1.1s; }

@keyframes steamDrift {
  0%, 100% {
    transform: translateY(12px) translateX(0) scaleY(0.75);
    opacity: 0.05;
  }
  40% {
    transform: translateY(-6px) translateX(3px) scaleY(1);
    opacity: 0.55;
  }
  70% {
    transform: translateY(-14px) translateX(-2px) scaleY(1.05);
    opacity: 0.25;
  }
}

.coffee-label {
  position: absolute;
  z-index: 4;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.55rem 1rem;
  border-radius: var(--radius-pill);
  background: rgba(248, 241, 229, 0.12);
  border: 1px solid rgba(248, 241, 229, 0.28);
  color: var(--color-cream);
  backdrop-filter: blur(6px);
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
}

.coffee-label--espresso { top: 16%; left: -2%; }
.coffee-label--milk { top: 46%; right: -4%; }
.coffee-label--foam { bottom: 12%; left: 6%; }

.coffee.is-inview .coffee-label {
  opacity: 1;
  transform: translateY(0);
}

.coffee.is-inview .coffee-label--espresso { transition-delay: 0.2s; }
.coffee.is-inview .coffee-label--milk { transition-delay: 0.4s; }
.coffee.is-inview .coffee-label--foam { transition-delay: 0.6s; }

@media (max-width: 799px) {
  .coffee__layout {
    grid-template-columns: 1fr;
  }

  .coffee__hero {
    order: -1;
    min-height: 22rem;
    max-width: 340px;
  }

  .coffee-label--milk {
    right: 0;
  }
}

/* ---------- Atmosphere ---------- */
.atmosphere {
  padding: 0;
}

.atmosphere__bleed {
  position: relative;
  min-height: min(88vh, 760px);
  display: grid;
  align-items: end;
}

.atmosphere__image {
  position: absolute;
  inset: 0;
}

.atmosphere__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.atmosphere__overlay {
  position: relative;
  z-index: 2;
  margin: 0 auto;
  padding: clamp(2.75rem, 7vw, 5rem) 0;
  color: var(--color-cream);
  background: linear-gradient(
    to top,
    rgba(44, 33, 28, 0.86) 0%,
    rgba(44, 33, 28, 0.38) 55%,
    transparent 100%
  );
  width: 100%;
  padding-inline: max(1.25rem, calc((100% - 1180px) / 2));
}

.atmosphere__title {
  color: var(--color-cream);
  margin-bottom: 1.25rem;
  font-size: clamp(3.75rem, 11vw, 7.25rem);
}

.atmosphere__title span {
  display: block;
}

.atmosphere__title span:last-child {
  font-style: italic;
  color: #c5d0bc;
}

.atmosphere__text {
  font-size: clamp(1.1rem, 2vw, 1.35rem);
  line-height: 1.55;
  max-width: 28ch;
  margin-bottom: 2rem;
  color: rgba(248, 241, 229, 0.88);
}

.atmosphere__highlights {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.55rem;
  max-width: 28rem;
}

.atm-item {
  display: grid;
  gap: 0.2rem;
  padding: 0.65rem 1.05rem;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(248, 241, 229, 0.28);
  background: rgba(248, 241, 229, 0.07);
  transition: background 280ms var(--ease-soft), border-color 280ms, transform 280ms var(--ease-out);
  cursor: default;
  max-width: 100%;
}

.atm-item__label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.atm-item__note {
  font-size: 0.88rem;
  letter-spacing: 0;
  text-transform: none;
  font-weight: 400;
  color: rgba(248, 241, 229, 0.78);
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 320ms var(--ease-out), opacity 280ms, margin 280ms;
}

.atm-item:hover,
.atm-item:focus-visible,
.atm-item.is-open {
  background: rgba(248, 241, 229, 0.14);
  border-color: rgba(248, 241, 229, 0.5);
  transform: translateX(4px);
  outline: none;
}

.atm-item:hover .atm-item__note,
.atm-item:focus-visible .atm-item__note,
.atm-item.is-open .atm-item__note {
  max-height: 4rem;
  opacity: 1;
  margin-top: 0.15rem;
}

@media (hover: none) {
  .atm-item__note {
    max-height: none;
    opacity: 0.85;
    margin-top: 0.15rem;
  }
}

/* ---------- Visit ---------- */
.visit {
  background:
    linear-gradient(180deg, var(--color-cream) 0%, var(--color-beige) 48%, var(--color-cream) 100%);
  padding: var(--space-2xl) 0;
}

.visit__invite {
  text-align: center;
  max-width: 42rem;
  margin-inline: auto;
}

.visit__title span {
  display: block;
}

.visit__title span:last-child {
  color: var(--color-green);
  font-style: italic;
}

.visit__details {
  margin: 2rem 0 2.25rem;
}

.visit__name {
  font-family: var(--font-display);
  font-size: 1.55rem;
  color: var(--color-brown);
  margin-bottom: 0.5rem;
}

.visit__address {
  color: var(--color-text-soft);
  line-height: 1.6;
}

.visit__phone {
  margin-top: 1rem;
  font-weight: 600;
  color: var(--color-brown);
  font-size: 1.15rem;
}

.visit__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.85rem;
}

/* ---------- Footer ---------- */
.site-footer {
  background: var(--color-brown);
  color: var(--color-cream);
  padding: var(--space-xl) 0 var(--space-lg);
}

.footer__top {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 2rem;
  margin-bottom: 3rem;
}

.footer__brand-mark {
  width: 4.5rem;
  height: 4.5rem;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 1rem;
  border: 3px solid rgba(248, 241, 229, 0.2);
}

.footer__brand h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 500;
  margin-bottom: 0.35rem;
}

.footer__brand p {
  color: rgba(248, 241, 229, 0.7);
}

.footer__col h3 {
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #a8b89f;
  margin-bottom: 1rem;
}

.footer__col a {
  display: block;
  margin-bottom: 0.55rem;
  color: rgba(248, 241, 229, 0.85);
  transition: color var(--duration-fast);
}

.footer__col a:hover {
  color: var(--color-cream);
}

.footer__note {
  color: rgba(248, 241, 229, 0.65);
  font-size: 0.95rem;
  margin-bottom: 1rem;
}

.footer__social {
  display: flex;
  gap: 0.65rem;
}

.footer__social span {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 1px solid rgba(248, 241, 229, 0.25);
  display: grid;
  place-items: center;
  font-size: 0.7rem;
  font-weight: 700;
  color: rgba(248, 241, 229, 0.5);
  cursor: default;
}

.footer__bottom {
  padding-top: 1.5rem;
  border-top: 1px solid rgba(248, 241, 229, 0.12);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.75rem;
  font-size: 0.88rem;
  color: rgba(248, 241, 229, 0.55);
}

@media (max-width: 700px) {
